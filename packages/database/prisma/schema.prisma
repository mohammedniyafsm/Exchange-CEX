generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  balances  Balance[]
  trades    Trade[]   @relation("UserTrades")
}

model Balance {
  userId    String
  asset     String
  available Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, asset])
}

model Trade {
  id            String   @id @default(cuid())
  market        String   // e.g. "SOL_USDC"
  price         Float
  quantity      Float
  buyOrderId    String
  sellOrderId   String
  buyerUserId   String
  sellerUserId  String
  createdAt     DateTime @default(now())
  user          User     @relation("UserTrades", fields: [buyerUserId], references: [id])
}