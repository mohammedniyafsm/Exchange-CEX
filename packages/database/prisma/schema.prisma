generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  balances        Balance[]
  orders          Order[]   @relation("UserOrders")
  buyerTrades     Trade[]   @relation("BuyerTrades")
  sellerTrades    Trade[]   @relation("SellerTrades")
}

model Balance {
  userId    String
  asset     String
  available Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, asset])
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  market    String
  side      OrderSide
  price     Float
  quantity  Float
  filled    Float       @default(0)
  status    OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())

  user       User    @relation("UserOrders", fields: [userId], references: [id])
  buyTrades  Trade[] @relation("BuyOrderTrades")
  sellTrades Trade[] @relation("SellOrderTrades")
}

model Trade {
  id         String   @id @default(uuid())
  tradeId    Int 
  market     String
  price      Float
  quantity   Float
  buyOrderId String
  sellOrderId String
  buyUserId  String
  sellUserId String
  createdAt  DateTime @default(now())

  buyOrder   Order  @relation("BuyOrderTrades", fields: [buyOrderId], references: [id])
  sellOrder  Order  @relation("SellOrderTrades", fields: [sellOrderId], references: [id])
  buyer      User   @relation("BuyerTrades", fields: [buyUserId], references: [id])
  seller     User   @relation("SellerTrades", fields: [sellUserId], references: [id])
}