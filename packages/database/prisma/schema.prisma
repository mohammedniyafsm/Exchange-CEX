generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  balances  Balance[]
}

model Balance {
  userId    String
  asset     String
  available Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, asset])
}