{
  "name": "@repo/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); const path=require('path'); const src=path.resolve('src/generated'); const dest=path.resolve('dist/generated'); if (fs.existsSync(src)) { fs.rmSync(dest,{recursive:true,force:true}); fs.cpSync(src, dest, { recursive: true }); }\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
